<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recipeDetailMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvRecipeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#176B2C"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvRecipeIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient list will appear here"
            android:textSize="16sp"
            android:textColor="#555555"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instructions"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvRecipeInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking instructions will appear here"
            android:textSize="16sp"
            android:textColor="#555555"
            android:lineSpacingExtra="6dp" />

        <Button
            android:id="@+id/btnBackToRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Recipes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6F50B5"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</ScrollView>